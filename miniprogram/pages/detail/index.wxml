<view class="page"><view class="eyebrow">THE NES COLLECTION</view><block wx:if="game"><view class="heading">{{game.title}}</view><view class="subtitle">{{game.description}}</view><view class="card card-body"><view class="row"><text>主机</text><text class="tag">NES / FC</text></view><view class="line">ROM 大小 · {{sizeLabel}}</view><view class="line">玩家 · 单人</view><view class="line">存档 · 1 个快存 + 3 个手动槽</view><view class="line">操作 · 方向、A / B、Start / Select</view></view><button class="primary" bindtap="play">进入播放器 ↗</button><view class="note">存档保存在当前设备中，可在播放器内导出备份。</view><view class="line hash">SHA-256<br/>{{game.sha256}}</view></block><view wx:else class="note">{{error || '正在读取卡带…'}}</view></view>
