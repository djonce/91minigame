page{background:#f6f4ed;color:#293025;font-family:-apple-system,"PingFang SC",sans-serif}.page{padding:44rpx}.eyebrow{font-size:17rpx;color:#81916e;letter-spacing:4rpx;margin-bottom:20rpx}.heading{font-size:50rpx;font-weight:700;line-height:1.35}.subtitle{font-size:24rpx;color:#87907b;line-height:1.8;margin-top:20rpx}.card{border:1rpx solid #dce0d3;border-radius:26rpx;overflow:hidden;margin-top:38rpx;background:#fcfbf6}.card-body{padding:34rpx}.card-title{font-size:34rpx;font-weight:650}.meta{font-size:21rpx;color:#89917f;margin-top:14rpx;line-height:1.8}.primary{margin-top:30rpx;background:#d5fd6e;color:#293923;font-size:26rpx;border-radius:16rpx;font-weight:650}.secondary{margin-top:20rpx;background:#e7ecdd;color:#4b5e3a;font-size:24rpx;border-radius:16rpx}button::after{border:0}.note{margin-top:32rpx;padding:26rpx;border:1rpx dashed #cbd5bc;border-radius:18rpx;color:#849273;font-size:22rpx;line-height:1.8}.error{color:#945a33}.footer{margin-top:55rpx;font-size:19rpx;color:#9ba591;text-align:center}.tag{display:inline-block;font-size:18rpx;padding:6rpx 14rpx;border-radius:30rpx;background:#e4ead9;color:#798b68}.row{display:flex;align-items:center;justify-content:space-between}.link{font-size:23rpx;color:#6e8256}.line{margin-top:26rpx;font-size:25rpx;line-height:1.8}.hash{font-family:monospace;font-size:19rpx;word-break:break-all;color:#8f9882}
